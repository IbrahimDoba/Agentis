# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local settings
.claude/

# local prompt files
prompt.md

# local debug/utility scripts
check-db.js

# typescript
*.tsbuildinfo
next-env.d.ts


# one-off planning docs
*.md
!README.md
!CLAUDE.md

# manual migration backups
prisma/migrations_manual_backup/

# generated prisma client — recreated by `postinstall` (prisma generate)
src/generated/

# one-off utility / backfill scripts (both .ts and .mjs diagnostic versions)
scripts/backfill-*
scripts/check-*
scripts/seed-*
scripts/setup-*
scripts/add-*
scripts/reset-*
scripts/insert-*
scripts/find-*
scripts/verify-*
scripts/apply-*

# raw WhatsApp history snapshots — PII, dev-only debugging artifact
worker/history_snapshots/
worker/auth_sessions/

# dev-only test endpoints (payment sandbox, etc.) — never ship to prod
src/app/api/test/

# local agent config export / scratch dump — contains per-agent system prompts,
# not read at runtime (runtime source is the DB)
worker/.agents.json

# generated client-facing docs (rendered locally, not source)
/Dailzero-AI-Services-and-Pricing.pdf
