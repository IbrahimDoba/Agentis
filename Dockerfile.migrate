# One-shot Prisma migration runner: applies pending migrations, then exits.
#
# Why this is a separate image rather than part of another service:
#   - Dockerfile.frontend must not run migrations. `next build` would then need a
#     reachable database, and an app container should not mutate the schema on
#     every boot or every replica restart.
#   - The worker and orchestrator cannot own it. They reach Postgres through raw
#     postgres.js and ship neither the Prisma CLI nor prisma/schema.prisma, both
#     of which belong to the workspace root package.
#
# `prisma migrate deploy` needs the CLI and the migration SQL — not the app's
# dependencies. Installing just the CLI keeps this at ~450 MB instead of the
# ~1.3 GB a full `pnpm install` of the root package produces.

FROM node:20.19.0-slim

WORKDIR /app

# Prisma's schema engine links against libssl, which node:slim does not ship.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Versions are read out of package.json rather than pinned here, so there is only
# ever one source of truth for which Prisma the migrations were written against.
# dotenv is required because prisma.config.ts imports it.
# package.json is read from /tmp, NOT copied into /app: `npm install <pkg>` in a
# directory that has a package.json also installs everything listed in it, which
# would drag next, three and the rest of the app into a migration image.
COPY package.json /tmp/root-package.json
RUN PRISMA_VERSION="$(node -p "require('/tmp/root-package.json').dependencies.prisma.replace(/^[^0-9]*/, '')")" \
    && DOTENV_VERSION="$(node -p "require('/tmp/root-package.json').devDependencies.dotenv.replace(/^[^0-9]*/, '')")" \
    && echo "installing prisma@${PRISMA_VERSION} dotenv@${DOTENV_VERSION}" \
    && npm install --no-audit --no-fund \
         "prisma@${PRISMA_VERSION}" "dotenv@${DOTENV_VERSION}" \
    && npm cache clean --force

COPY prisma.config.ts ./
COPY prisma ./prisma

# Environment: exactly one variable is required, a Postgres URL. Nothing else —
# no AUTH_SECRET, no API keys.
#
# prisma.config.ts resolves it as `DIRECT_URL ?? DATABASE_URL`, so DIRECT_URL
# WINS when both are set. A stale DIRECT_URL therefore silently overrides a
# correct DATABASE_URL; with self-hosted Postgres there is no pooler, so either
# set both to the same value or set only DATABASE_URL.
#
# A `.env` file is NOT read — Prisma 7 dropped automatic .env loading, and
# prisma.config.ts explicitly loads `.env.local` only. Inside this image neither
# exists (.dockerignore excludes .env*), so pass the URL as a container
# environment variable. Verified against all five combinations.
#
# `migrate deploy` only rolls forward and takes a Postgres advisory lock, so it
# is safe to re-run and safe if two deploys race.
#
# Note what is deliberately absent: the `prisma migrate resolve --applied
# 20240101000000_baseline` step from package.json's build script. That exists to
# baseline a database whose tables predate the baseline migration. Run against a
# FRESH database it records the baseline as applied without creating any tables,
# and the next migration then dies with `relation "User" does not exist`, leaving
# the database with _prisma_migrations and nothing else. Verified, not assumed.
CMD ["npx", "prisma", "migrate", "deploy"]
