FROM node:20.19.0-slim

WORKDIR /app

# Install pnpm and pm2
RUN npm install -g pnpm@10.31.0 pm2

# ffmpeg converts status videos to the 720p H.264 Main profile WhatsApp plays
# when the post comes from a linked device (higher profiles arrive but won't play).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

# Copy workspace root files first (for better caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all packages (Worker workspace requires context)
COPY orchestrator ./orchestrator
COPY worker ./worker
COPY prisma ./prisma
COPY scripts ./scripts

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Build worker only
WORKDIR /app/worker
RUN pnpm build

# Auth sessions persist on a Railway Volume — never baked into the image.
# AUTH_STORAGE_DIR MUST equal the volume's mount path. whatsapp-worker-volume is
# mounted at /app/auth_sessions; without this the worker would write auth to
# /app/worker/auth_sessions (runtime cwd is /app/worker) — ephemeral disk — and
# re-download every backup from Supabase on each restart (Supabase egress).
ENV NODE_ENV=production
ENV AUTH_STORAGE_DIR=/app/auth_sessions
EXPOSE 4000

CMD ["pm2-runtime", "ecosystem.config.cjs"]
