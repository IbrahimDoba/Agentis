enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
