generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String
  phone          String?
  businessName   String
  passwordHash   String?
  role           Role       @default(USER)
  status         UserStatus @default(PENDING)
  // Multi-tenant: which reseller (white-label tenant) this user belongs to.
  // Existing users backfill to the root tenant "platform". Email is unique
  // PER tenant (see @@unique below), so the same address can exist on Dailzero
  // and on a reseller's site independently. (resellerId is served by the leading
  // column of @@unique([resellerId, email]); status/plan get their own indexes
  // below for admin counts + the daily renewal/expiry cron scans.)
  resellerId     String     @default("platform")
  reseller       Reseller   @relation("ResellerUsers", fields: [resellerId], references: [id])
  workspaceMembers   WorkspaceMember[] @relation("WorkspaceOwner")
  memberOf           WorkspaceMember[] @relation("WorkspaceMemberUser")
  resetToken            String?    @unique
  resetTokenExpiry      DateTime?
  emailVerified         Boolean    @default(false)
  verificationCode      String?
  verificationCodeExpiry DateTime?
  businessCategory    String?
  businessDescription String?
  businessGoals       String?
  businessAddress     String?
  businessEmail       String?
  businessWebsite     String?
  // Optional "how did you hear about us?" answer captured at signup (Instagram,
  // TikTok, Friend, etc.) — for attribution/analytics. Shown in admin.
  referralSource      String?
  maxAgents               Int        @default(1)
  plan                    String     @default("free")
  subscriptionExpiresAt   DateTime?
  // Explicit start of the current billing cycle, stamped on every activation,
  // renewal, and admin usage-reset. The credit-usage window is
  // [currentPeriodStart, subscriptionExpiresAt]; null falls back to the legacy
  // rolling-30-day inference (see lib/billing-period.ts). Anchoring the start
  // fixes a lapsed resubscribe carrying the previous cycle's usage.
  currentPeriodStart      DateTime?
  expiryWarningEmailSentAt DateTime?
  expiredEmailSentAt       DateTime?
  // Paystack recurring billing. Captured on the first successful subscription
  // charge (a hosted-checkout payment) and reused by the renewal cron via
  // charge_authorization. Auto-renew only runs when authorizationReusable.
  paystackAuthorizationCode String?
  paystackCustomerCode      String?
  cardLast4                 String?
  cardBrand                 String?
  cardExpiry                String?   // "MM/YY", for the "update card" UI
  authorizationReusable     Boolean   @default(false)
  autoRenew                 Boolean   @default(false)
  subscriptionStatus        String    @default("none") // none | active | past_due | cancelled
  cancelAtPeriodEnd         Boolean   @default(false)
  pendingPlan               String?   // scheduled downgrade, applied at next renewal
  renewalRetryCount         Int       @default(0)
  lastRenewalAttemptAt      DateTime?
  paymentFailedEmailSentAt  DateTime?
  // Pay-as-you-go wallet. Spent only after the user's plan allowance is
  // exhausted for the cycle. `creditsExpireAt` is set to (now + 12mo) on
  // every top-up — rolling expiry, so active users never lose credits.
  creditBalance           Int        @default(0)
  creditsExpireAt         DateTime?
  // One-cycle carryover: unused plan allowance kept when the plan CHANGES
  // (upgrade or downgrade). Added on top of the new plan's monthly allowance
  // until `carryoverExpiresAt` (= that cycle's end), then dropped at the next
  // same-plan renewal. Not touched by top-ups (that's the wallet above).
  carryoverCredits        Int        @default(0)
  carryoverExpiresAt      DateTime?
  onboardingCompleted     Boolean    @default(false)
  referralsEnabled    Boolean    @default(false)
  historySyncEnabled  Boolean    @default(false)
  developerModeEnabled Boolean   @default(false)
  // Gates the Meta tab — accounts provisioned on the official WhatsApp Cloud
  // API. Off for everyone on the Baileys channel, for whom the WABA/template
  // views have nothing to show.
  metaEnabled         Boolean    @default(false)
  // Opt-in (default ON) for the account owner's lead/handoff email alerts and
  // the daily/weekly activity digests. See src/lib/lead-notifications-job.ts.
  leadNotificationsEnabled Boolean @default(true)
  // Account-wide defaults for appointment reminders (lead minutes before the
  // appointment). Every new Appointment copies these; each one is then editable
  // per-appointment. Reminder 2 can be disabled per-appointment (null). See
  // src/lib/appointment-reminders-job.ts.
  appointmentReminder1Minutes Int  @default(60)
  // Nullable so an account can default new appointments to a single reminder.
  appointmentReminder2Minutes Int? @default(15)
  createdAt           DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  agents             Agent[]
  leads              Lead[]
  appointments       Appointment[]
  conversationReads  ConversationRead[]
  referralCode       String?    @unique
  referralsMade      Referral[] @relation("ReferralsMade")
  referredBy         Referral?  @relation("ReferredBy")
  paymentRequests    PaymentRequest[]
  creditPurchases    CreditPurchase[]
  subscriptionCharges SubscriptionCharge[]
  apiKeys            ApiKey[]

  // Email is unique within a tenant, not globally.
  @@unique([resellerId, email])
  @@index([status])
  @@index([plan, subscriptionExpiresAt])
}

// A reseller = a white-label tenant. The root tenant (Dailzero itself) is a
// fixed row with id "platform", so there's no special-casing — every user
// belongs to exactly one reseller. Co-branded: appName/logo/color are shown to
// her users while a "powered by Dailzero" footer stays.
model Reseller {
  id              String   @id @default(cuid()) // root tenant has fixed id "platform"
  name            String // internal name
  domain          String   @unique // primary host, e.g. resellers-site.com
  domainAliases   String[] @default([]) // extra hosts that also map here
  appName         String // brand shown to her users
  logoUrl         String?
  primaryColor    String? // hex accent
  supportEmail    String?
  supportWhatsapp String? // support number; users get a "Contact support" wa.me link
  status          String   @default("active") // active | suspended
  // Wholesale credit pool you allocate her. Her users' AI sends draw from this;
  // when it hits zero her tenant pauses until you top it up. `creditPool` is the
  // live balance; `creditPoolTotal` is the lifetime allocation (admin display).
  creditPool      Int      @default(0)
  creditPoolTotal Int      @default(0)
  adminUserId     String? // her RESELLER_ADMIN account
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]         @relation("ResellerUsers")
  plans           ResellerPlan[]
}

// A reseller's own custom plan — any name, any price (she collects payment
// herself, offline), any credit allowance, any duration. She assigns one to a
// user and activates it manually from her admin; the user then runs on that
// allowance, drawing the reseller's pool. No checkout code for her tenant.
model ResellerPlan {
  id           String   @id @default(cuid())
  resellerId   String
  reseller     Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  name         String
  priceNaira   Int // her price (record/display only — collected manually)
  credits      Int // allowance granted per period
  durationDays Int      @default(30)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([resellerId])
}

// External Developer API keys. One user → many keys. The raw key is shown
// ONCE at creation and never stored — only its bcrypt hash. `prefix` is the
// public, indexed lookup id (also shown masked in the dashboard); verify
// narrows by prefix then bcrypt-compares. `scopes` gate capability: "chat"
// (run agents — safe to embed client-side) and/or "manage" (configure agents
// — server-side only), so a leaked chat key can't reconfigure agents.
model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String                       // operator-visible label
  prefix    String   @unique             // public lookup id, e.g. "dz_live_a1b2c3d4"
  hashedKey String                       // bcrypt(full raw key) — raw never persisted

  scopes    String[] @default([])        // "chat" | "manage"

  // Per-key safety rail: optional rolling 24h spend cap (in credits).
  dailySpendingCapCredits Int?
  dailySpentCredits       Int       @default(0)
  spendingResetAt         DateTime?

  status     String    @default("active") // "active" | "revoked"
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, status])
}

model Agent {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String
  businessDescription  String      @db.Text
  productsServices     String      @db.Text
  faqs                 String      @db.Text
  operatingHours       String
  contactEmail         String?
  contactPhone         String?
  websiteLinks         String?
  responseGuidelines   String?     @db.Text
  profileImageUrl      String?
  whatsappBusinessName String?
  whatsappAgentLink    String?
  whatsappPhoneNumber  String?
  qrCodeUrl            String?
  elevenlabsAgentId    String?
  whatsappPhoneNumberId String?
  messagingEnabled     Boolean     @default(true)
  // Global master switch for AI replies. When false, the orchestrator skips the
  // AI for ALL of this agent's conversations (every message goes to a human),
  // regardless of per-conversation mode. Default true.
  aiRepliesEnabled     Boolean     @default(true)
  // Opt-in for WhatsApp group chats. While false the worker drops group
  // messages at ingest exactly as before this feature existed.
  groupChatEnabled     Boolean     @default(false)
  autoPauseOnHumanReply Boolean    @default(true)
  pauseOnAiHandoff     Boolean     @default(true)
  pauseOnQualifiedLead Boolean     @default(true)
  // Minutes of inactivity after which a human-mode conversation auto-switches
  // back to AI. null = off (the AI stays paused until a human resumes it).
  autoResumeAiAfterMinutes Int?
  // Seconds to wait before the AI replies. Doubles as a debounce window: rapid
  // messages within it are batched into a single combined reply instead of one
  // reply each. 0 = reply instantly (no batching).
  replyDelaySeconds    Int         @default(0)
  isVerified           Boolean     @default(false)
  autoConfigStatus     String?
  autoConfigInputs     Json?
  autoConfigDraft      Json?
  autoConfigStartedAt   DateTime?
  autoConfigCompletedAt DateTime?
  category             String?
  address              String?
  productsData         Json?
  // When on, the AI may send the whole product catalogue as one WhatsApp album
  // (via the send_product_catalog tool) when a customer asks to see products.
  // productAlbumTitle is the optional intro line sent above the album.
  productAlbumEnabled  Boolean     @default(false)
  productAlbumTitle    String?
  // When on, a second model reviews each AI reply before sending (rewrite /
  // handoff / suppress). Off by default — the guard can over-suppress and
  // silence legitimate replies; enable per agent once tuned/trusted.
  replyGuardEnabled    Boolean     @default(false)
  // When on, the AI may tag/categorise chats with the business's WhatsApp
  // labels (the tag_conversation tool). Off by default.
  chatTaggingEnabled   Boolean     @default(false)
  // When on, the AI also keeps tagging while a HUMAN is handling the chat — a
  // cheap, throttled classify-only pass (no reply). Off by default; only matters
  // when chatTaggingEnabled is also on.
  backgroundTaggingEnabled Boolean @default(false)
  // Gates the AI's schedule_appointment tool. Off by default so only agents
  // whose business actually books appointments/inspections get it. Manual
  // (human) appointment creation works regardless of this flag.
  appointmentSchedulingEnabled Boolean @default(false)
  toolsData            Json?
  openaiApiKey         String?
  transportType        String      @default("waba")
  agentRuntime         String      @default("elevenlabs")
  status               AgentStatus @default(PENDING_REVIEW)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  leads                Lead[]
  appointments         Appointment[]
  conversationLogs     ConversationLog[]
  customers            Customer[]
  templates            MessageTemplate[]
  baileysSession       BaileysSession?
  orchestratorAgents   OrchestratorAgent[]
  conversations        Conversation[]
  broadcasts           BroadcastCampaign[]
  followUpCampaigns    FollowUpCampaign[]
  embedSite            EmbedSite?
  whatsappLabels       WhatsAppLabel[]
  chatLabels           ChatLabel[]
  groupChats           GroupChat[]
  promptEdits          PromptEdit[]
  baileysAuthKeys      BaileysAuthKey[]

  // Postgres does not auto-index FKs. `userId` is the app's hottest filter
  // (dashboard, billing, stats poll); `agentRuntime`/`elevenlabsAgentId` gate
  // runtime routing and voice-webhook lookups.
  @@index([userId, status])
  @@index([agentRuntime])
  @@index([elevenlabsAgentId])
}

// A WhatsApp Business label synced from the connected phone (read-only mirror of
// WhatsApp — labels are created/edited there). The "mix" config lives here:
// isStage/stageOrder mark a label as part of an ordered funnel (one active per
// chat, AI swaps it); the rest are additive tags. applyRule is the optional
// per-label criteria override (empty = AI infers from the name).
model WhatsAppLabel {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  waLabelId    String                       // WhatsApp's label id
  name         String
  color        Int      @default(0)
  predefinedId String?                      // set for WhatsApp's 5 built-ins
  deleted      Boolean  @default(false)
  isStage      Boolean  @default(false)     // part of the stage funnel vs additive tag
  stageOrder   Int?                         // funnel position (lower = earlier)
  applyRule    String?                      // optional "when to apply" criteria
  // When true, the AI does NOT reply to any chat carrying this label — it stays
  // silent for a human to handle (dynamic: remove the label and the AI resumes).
  aiDisabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([agentId, waLabelId])
}

// Which labels are on which chat. Keyed on the WhatsApp chat id (not a
// Conversation) so it works for any chat, including ones the AI hasn't handled
// yet; phoneNumber is the resolved number for joining to Conversation in the UI.
model ChatLabel {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chatJid     String                        // WhatsApp chat remoteJid
  phoneNumber String?                       // resolved, for joining to Conversation
  waLabelId   String
  appliedBy   String   @default("whatsapp") // whatsapp(synced) | ai | operator
  createdAt   DateTime @default(now())

  @@unique([agentId, chatJid, waLabelId])
  @@index([agentId, phoneNumber])
  @@index([agentId, waLabelId])
}

model EmbedSite {
  id             String   @id @default(cuid())
  agentId        String   @unique
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  publicKey      String   @unique
  allowedOrigins String[] @default([])
  themeJson      Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publicKey])
}

model FollowUpCampaign {
  id           String    @id @default(cuid())
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status       String    @default("scanning") // scanning | review | scheduled | sending | completed | cancelled | failed
  mode         String    @default("auto")     // auto | review
  minDaysSince Int       @default(1)
  // Optional: restrict the scan to chats carrying this WhatsApp label
  // (e.g. only "warm leads"). null = all eligible conversations.
  targetLabelId   String?
  targetLabelName String?
  totalScanned Int       @default(0)
  totalFound   Int       @default(0)
  totalSent    Int       @default(0)
  totalSkipped Int       @default(0)
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  messages     FollowUpMessage[]

  @@index([agentId])
}

model FollowUpMessage {
  id               String           @id @default(cuid())
  campaignId       String
  campaign         FollowUpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  phoneNumber      String
  jid              String
  contactName      String?
  aiReason         String?
  generatedMessage String           @db.Text
  status           String           @default("pending") // pending | approved | rejected | scheduled | sent | skipped | failed
  scheduledAt      DateTime?
  sentAt           DateTime?
  error            String?
  createdAt        DateTime         @default(now())

  @@index([campaignId])
  @@index([conversationId])
}

model BroadcastCampaign {
  id          String               @id @default(cuid())
  agentId     String
  agent       Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  message     String               @db.Text
  status      String               @default("pending") // pending | running | paused | completed | cancelled | failed
  totalCount  Int                  @default(0)
  sentCount   Int                  @default(0)
  failedCount Int                  @default(0)
  // How many hours to spread the whole send over. The recipients are paced
  // evenly across this window (like AI follow-ups) so messages go out gradually,
  // not all at once. null = the default 24h. Minimum 24h is enforced on write.
  spreadHours Int?
  createdAt   DateTime             @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  recipients  BroadcastRecipient[]

  @@index([agentId])
}

model BroadcastRecipient {
  id          String            @id @default(cuid())
  broadcastId String
  broadcast   BroadcastCampaign @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  phoneNumber String
  jid         String
  contactName String?
  status      String            @default("pending") // pending | sent | failed | skipped
  error       String?
  sentAt      DateTime?

  @@index([broadcastId])
}

model GroupChat {
  id             String        @id @default(cuid())
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupJid       String
  subject        String?
  // The Conversation carrying this group's thread. Null until the first
  // addressed message creates it — we track a group from first sighting, but
  // only open a thread once there is something to put in it.
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // 'mention' = reply only when addressed; 'off' = ingest and log, never reply.
  replyMode      String        @default("mention")
  joinedAt       DateTime      @default(now())
  lastMessageAt  DateTime?

  @@unique([agentId, groupJid])
  @@index([agentId])
}

model PromptEdit {
  id                String    @id @default(cuid())
  agentId           String
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Who clicked Apply — the viewer, which may not be the workspace owner.
  userId            String
  field             String
  instruction       String    @db.Text
  // The verified ops with their resolved offsets, so the history view can
  // render exactly what changed without recomputing a diff.
  ops               Json
  // Full snapshots so a rollback is an exact restore. An inverse splice would
  // rot the moment someone hand-edits the prompt in the Configuration tab.
  // Null above SNAPSHOT_MAX (see snapshotTruncated), where ops + hashes are the
  // fallback.
  beforeValue       String?   @db.Text
  afterValue        String?   @db.Text
  // sha256. Doubles as optimistic concurrency on apply and drift detection on
  // revert — without it two open tabs silently clobber each other.
  beforeHash        String
  afterHash         String
  snapshotTruncated Boolean   @default(false)
  model             String
  promptTokens      Int       @default(0)
  outputTokens      Int       @default(0)
  revertedAt        DateTime?
  revertedBy        String?
  createdAt         DateTime  @default(now())

  @@index([agentId, createdAt])
}

model OrchestratorAgent {
  id               String         @id @default(cuid())
  agentId          String
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name             String
  systemPrompt     String         @db.Text
  personality      String?        @db.Text
  model            String         @default("gpt-4o-mini")
  temperature      Decimal        @default(0.7) @db.Decimal(3, 2)
  maxOutputTokens  Int            @default(800)
  shortTermWindow  Int            @default(20)
  summarizeAfter   Int            @default(30)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  conversations    Conversation[]
}

model Document {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String
  filename         String
  mimeType         String
  sizeBytes        BigInt
  r2Key            String
  status           String          @default("pending")
  error            String?
  chunkCount       Int?            @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz()
  chunks           DocumentChunk[]
}

model DocumentChunk {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String          @db.Uuid
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agentId          String
  chunkIndex       Int
  content          String
  // Using Unsupported for pgvector as Prisma requires native support for vector
  embedding        Unsupported("vector(1536)")?
  metadata         Json?           @default("{}")
  createdAt        DateTime        @default(now()) @db.Timestamptz()

  @@index([agentId])
}

model MediaItem {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String
  filename         String
  mimeType         String
  r2Key            String
  description      String
  tags             String[]        @default([])
  createdAt        DateTime        @default(now()) @db.Timestamptz()

  @@index([agentId])
}

model Conversation {
  id                   String              @id @default(cuid())
  agentId              String
  agent                Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orchestratorAgentId  String?
  orchestratorAgent    OrchestratorAgent?  @relation(fields: [orchestratorAgentId], references: [id], onDelete: SetNull)
  phoneNumber          String
  contactName          String?
  // Raw WhatsApp chat JID (e.g. "<lid>@lid" or "<phone>@s.whatsapp.net") from the
  // inbound message. Bridges to ChatLabel.chatJid so label features (AI-off,
  // follow-up-by-label) join reliably despite the LID↔phone duality that
  // phoneNumber alone can't. Backfilled as each customer messages.
  senderJid            String?
  mode                 String              @default("ai")
  // When true, this conversation stays human forever — the auto-resume-AI
  // sweep skips it, so the timer never flips it back to AI.
  aiLocked             Boolean             @default(false)
  channel              String              @default("whatsapp")
  visitorId            String?
  lastActivityAt       DateTime?           @default(now())
  factsExtractedAt     DateTime?
  lastFollowedUpAt     DateTime?
  adContext            Json?
  handoffReason        String?
  handoffAt            DateTime?
  handoffUrgency       String?
  // When the owner was emailed about this handoff request. Reset implicitly by
  // a newer handoffAt so a fresh handoff on the same conversation re-notifies.
  handoffNotifiedAt    DateTime?
  leadQualifiedAt      DateTime?
  leadIntent           String?
  // Set when the full product album was last sent to this conversation. Used to
  // stop the AI re-dumping the whole catalogue (a credit drain) — once sent, the
  // album only resends when the customer explicitly asks to see everything again.
  lastProductAlbumSentAt DateTime?
  // Soft delete. When set: hidden from the conversations tab AND acts as the AI
  // memory cutoff — the orchestrator only feeds the model messages sent AFTER
  // this timestamp, so it "forgets" everything prior (a clean per-conversation
  // memory reset). The row + messages are preserved; nothing is destroyed.
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  messages             Message[]
  summary              ConversationSummary?
  groupChat            GroupChat?
  followUpMessages     FollowUpMessage[]

  @@unique([agentId, phoneNumber])
  @@index([agentId, visitorId])
  @@index([agentId, senderJid])
  @@index([agentId, lastActivityAt])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction        String
  senderRole       String       @default("ai")  // "ai" | "human" (outbound only)
  // Group inbound only — which participant spoke. Null on all 1:1 traffic,
  // where the conversation itself identifies the sender.
  senderJid        String?
  senderName       String?
  content          String       @db.Text
  mediaUrl         String?
  mediaDescription String?      @db.Text
  toolCalls        Json?
  richContent      Json?
  tokensInput      Int?
  tokensOutput     Int?
  modelUsed        String?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ConversationSummary {
  conversationId             String       @id
  conversation               Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary                    String       @db.Text
  messagesCovered            Int
  summarizedThroughMessageId String?
  updatedAt                  DateTime     @default(now()) @updatedAt
}

model MessageTemplate {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id             String     @id @default(cuid())
  conversationId String
  agentId        String
  userId         String
  callerNumber   String?
  summary        String?    @db.Text
  status         LeadStatus @default(NEW)
  notes          String?    @db.Text
  aiDetected     Boolean    @default(false)
  // When the owner was emailed about this lead (instant alert). Null = not yet
  // notified; the poller only emails high-intent leads (aiDetected = false).
  notifiedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  agent          Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, createdAt])
  // Poller lookup: unnotified, high-intent leads by recency.
  @@index([aiDetected, notifiedAt, createdAt])
}

model ConversationRead {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  readAt         DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

enum Role {
  USER
  ADMIN
  RESELLER_ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgentStatus {
  PENDING_REVIEW
  SETTING_UP
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

// An appointment/meeting/inspection the AI (schedule_appointment tool) or a
// human (dashboard "New appointment") booked with a customer. The reminder cron
// (src/lib/appointment-reminders-job.ts) emails the owner + accepted team
// members ahead of `scheduledAt`, at up to two independent lead times, and — for
// chat-linked appointments — also sends the customer a WhatsApp nudge in-thread.
model Appointment {
  id             String            @id @default(cuid())
  agentId        String
  userId         String            // workspace owner — the reminder recipient scope
  // Null for a purely-manual appointment not tied to a chat. When set, links
  // back to the conversation it was booked in.
  conversationId String?
  customerName   String?
  customerNumber String?
  title          String            // what it is: "Property inspection", "Consultation"…
  notes          String?           @db.Text
  scheduledAt    DateTime          @db.Timestamptz()   // the appointment instant (UTC)
  status         AppointmentStatus @default(SCHEDULED)
  createdBy      String            @default("ai")       // "ai" | "human"
  // Two independent reminders. `reminderNMinutes` = lead time (minutes before
  // scheduledAt); `reminderNSentAt` is the idempotency stamp (null until sent).
  // Reminder 2 is disabled when its minutes are null. A reschedule clears both
  // stamps so the reminders re-fire for the new time.
  reminder1Minutes Int             @default(60)
  reminder1SentAt  DateTime?
  reminder2Minutes Int?            @default(15)
  reminder2SentAt  DateTime?
  // Instant "appointment booked" email to owner + team, sent once just after
  // creation (idempotency stamp; null = not yet notified). Distinct from the
  // reminder stamps above.
  bookedNotifiedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  agent          Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  // Reminder cron scan: upcoming, still-SCHEDULED appointments by time.
  @@index([status, scheduledAt])
  // Instant "booked" scan: newly-created, not-yet-notified appointments.
  @@index([bookedNotifiedAt, createdAt])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Customer {
  id                  String    @id @default(cuid())
  phoneNumber         String    @unique
