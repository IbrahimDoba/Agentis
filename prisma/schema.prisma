enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model PaymentRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  amountNaira Int
  status      PaymentStatus @default(PENDING)
  reference   String        @unique @default(cuid())
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model BaileysSession {
  id                   String           @id @default(cuid())
  agentId              String           @unique
  agent                Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  phoneNumber          String?
  status               BaileysStatus    @default(DISCONNECTED)
  lastConnectedAt      DateTime?
  lastDisconnectReason String?
  linkedDeviceName     String           @default("Dailzero AI")
  authBackupPath       String?
  warmupStartedAt      DateTime?
  warmupTier           Int              @default(1)
  historySyncedAt      DateTime?
  dailyMessageCount    Int              @default(0)
  dailyCountResetAt    DateTime         @default(now())
  businessHoursStart   String           @default("08:00")
  businessHoursEnd     String           @default("21:00")
  timezone             String           @default("Africa/Lagos")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  outboundLogs         BaileysOutboundLog[]
}

// Baileys signal auth state, one row per key. Replaces the per-file volume
// store (useMultiFileAuthState) so the auth footprint can never exhaust the
// disk's INODES — the root cause of the duplicate-delivery incident. `category`
// is the Baileys SignalData type ("creds" | "session" | "pre-key" | "sender-key"
// | "sender-key-memory" | "app-state-sync-key" | "app-state-sync-version");
// `keyId` mirrors the file store's fixed id; `value` is the AES-256-GCM
// encrypted BufferJSON blob. Written by the worker via raw SQL, not Prisma.
model BaileysAuthKey {
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  category  String
  keyId     String
  value     Bytes
  updatedAt DateTime @default(now()) @updatedAt

  @@id([agentId, category, keyId])
  @@index([agentId])
}

model BaileysOutboundLog {
  id             String                 @id @default(cuid())
  sessionId      String
  session        BaileysSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversationId String?
  toJid          String
  messagePreview String?
  queuedAt       DateTime               @default(now())
  sentAt         DateTime?
  delayAppliedMs Int?
  status         BaileysOutboundStatus  @default(QUEUED)
}

enum BaileysStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTING
  CONNECTED
  LOGGED_OUT
  BANNED
}

enum BaileysOutboundStatus {
  QUEUED
  SENT
  FAILED
  RATE_LIMITED
}

model CreditUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String
  conversationId String?
  messageType    String
  source         String   @default("ai")
  creditsUsed    Int
  // PAYG audit (nullable so historical rows still validate):
  // tokensInput / tokensOutput let the support UI reconstruct exactly why
  // a given message cost what it cost. billedTo distinguishes plan vs wallet.
  tokensInput    Int?
  tokensOutput   Int?
  billedTo       String?  // 'plan' | 'wallet'
  createdAt      DateTime @default(now()) @db.Timestamptz()

  @@index([agentId, createdAt])
  @@index([conversationId])
}

// Audit log of every Paystack credit top-up. One row per purchase attempt;
// `reference` is unique so duplicate webhook deliveries are no-ops.
model CreditPurchase {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountNaira  Int                                      // gross price paid by the user
  netNaira     Int                                      // after Paystack fees
  creditsAdded Int                                      // credits granted on completion
  unitRateNGN  Decimal       @db.Decimal(6, 3)         // for audit (NGN per credit at purchase time; 6 digits total, 3 after the point)
  reference    String        @unique                    // Paystack transaction ref
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  completedAt  DateTime?
  expiresAt    DateTime                                 // = completedAt + 12 months (when known)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

// Ledger + idempotency anchor for every monthly-plan charge through Paystack
// (initial subscribe, auto-renewal, mid-cycle upgrade). Mirrors CreditPurchase.
// The unique `reference` makes webhook/cron replays safe; renewals use a
// deterministic per-cycle reference so a double charge is impossible.
model SubscriptionCharge {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String                                   // plan being paid for
  amountNaira   Int                                      // total charged (planNaira + overageNaira)
  planNaira     Int                                      // plan-price portion
  overageNaira  Int           @default(0)                // prior-cycle overage portion (starter/pro)
  netNaira      Int                                      // after Paystack fees
  reference     String        @unique                    // idempotency anchor (deterministic per cycle)
  status        PaymentStatus @default(PENDING)
  kind          String        @default("renewal")        // initial | renewal | upgrade
  periodStart   DateTime
  periodEnd     DateTime
  failureReason String?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

// Admin finance tracking (the /admin/finances tab). Manually-entered expenses
// and revenue for a simple P&L. Amounts are whole units of `currency` (NO minor
// units — same Int convention as the *Naira columns). Multi-currency: each row
// carries its own currency and is converted to the NGN base via FinanceFxRate
// for the combined totals. `recurring` marks a monthly run-rate line vs a
// one-off. This is bookkeeping, not billing — nothing here charges anyone.
model FinanceEntry {
  id         String   @id @default(cuid())
  kind       String                                   // "expense" | "revenue"
  label      String                                   // category (Hosting, APIs, Salaries…) or revenue name
  amount     Int                                      // whole units of `currency`
  currency   String   @default("NGN")                 // ISO 4217 code
  recurring  Boolean  @default(true)                  // monthly run-rate vs one-off
  note       String?
  incurredAt DateTime @default(now())                 // when it applies (month views / "so far")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([kind, incurredAt(sort: Desc)])
}

// Editable FX rates for the finance tab. Base currency is NGN (rate 1, implicit
// — no row needed). Each row says: 1 unit of `currency` == `rateToBase` NGN.
model FinanceFxRate {
  currency   String   @id                             // ISO 4217 code (e.g. "USD")
  rateToBase Decimal  @db.Decimal(18, 6)              // 1 `currency` = this many NGN
  updatedAt  DateTime @updatedAt
}

// Structured failure/event log written by the worker (connection failures, send
// failures, etc.) so production issues are diagnosable from the DB / admin panel
// without Railway log access. High-signal, low-volume — only warnings/errors.
model WorkerEvent {
  id        String   @id @default(cuid())
  level     String                                   // "warn" | "error"
  category  String                                   // e.g. "session.closed", "broadcast.send_failed"
  agentId   String?
  userId    String?
  message   String   @db.Text
  detail    Json?                                    // { statusCode, reason, jid, error, ... }
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([category, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// Isolated message log for the Meta Cloud API test harness (branch:
// meta-integration). Deliberately SEPARATE from Conversation/Message so the
// official-API screencast demo never bleeds into real dashboard data. One row
// per inbound/outbound message on the test number, keyed by the customer's
// wa_id. `raw` backs the on-camera event log (raw webhook value / send response).
model MetaTestMessage {
  id          String   @id @default(cuid())
  waId        String                                  // customer WhatsApp id — E.164 digits, no "+"
  direction   String                                  // "inbound" | "outbound"
  text        String   @db.Text
  waMessageId String?                                 // Meta wamid, for dedup + status matching
  raw         Json?
  createdAt   DateTime @default(now()) @db.Timestamptz()

  @@index([waId, createdAt])
  @@index([createdAt(sort: Desc)])
}

// A WhatsApp Business Account connected through Embedded Signup (branch:
// meta-integration). One row per connected phone number — the harness routes
// each inbound webhook to a row by phoneNumberId, which is what makes the flow
// multi-tenant rather than the single number pinned in env.
//
// `accessToken` is the business token from the code exchange, encrypted at rest
// with AES-256-GCM (see src/lib/meta/crypto.ts) — it grants messaging rights on
// someone else's number, so it never sits in plaintext.
model MetaTestConnection {
  id                 String    @id @default(cuid())
  wabaId             String
  phoneNumberId      String    @unique
  displayPhoneNumber String?
  verifiedName       String?
  businessId         String?
  accessToken        Bytes
  // Null until the number is registered / the app subscribed — the two Graph
  // calls that finish the handshake, each of which can fail independently.
  registeredAt       DateTime? @db.Timestamptz()
  subscribedAt       DateTime? @db.Timestamptz()
  createdAt          DateTime  @default(now()) @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @db.Timestamptz()

  @@index([wabaId])
}
